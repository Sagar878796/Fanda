
const PLAYLISTS = [
  {
    name: "SonyLIV",
    url: "https://raw.githubusercontent.com/sportlive18/Sonyliv-Playlist-Autoupdate/refs/heads/main/sonyliv.m3u"
  },
  {
    name: "JioSTB Plus",
    url: "https://jiostbplus.saregojo99.workers.dev/m3u"
  },
  {
    name: "Fancode Premium",
    url: "https://premiumplugx.top/mylive/playlist.php"
  },
  {
    name: "Star TV",
    url: "https://mainplaylist.poonamchouhan076.workers.dev/"
  },
  {
    name: "Fancode",
    url: "https://raw.githubusercontent.com/doctor-8trange/zyphx8/refs/heads/main/data/fancode.m3u"
  }
];

const PLAYLIST_KEY = "Combined.m3u";
const STATUS_KEY = "update-status";

async function updatePlaylist(env) {
  const combined = ["#EXTM3U"];
  const results = [];
  let totalChannels = 0;

  for (const playlist of PLAYLISTS) {
    try {
      console.log("Downloading:", playlist.name);

      const response = await fetch(playlist.url, {
        headers: {
          "User-Agent": "Mozilla/5.0",
          "Accept": "*/*"
        },
        signal: AbortSignal.timeout(120000)
      });

      if (!response.ok) {
        throw new Error("HTTP " + response.status);
      }

      const content = await response.text();
      const lines = content.replace(/^\uFEFF/, "").split(/\r?\n/);

      let channels = 0;

      for (let line of lines) {
        line = line.trim();

        if (!line || line === "#EXTM3U") continue;

        // Decode proxy URL
        if (
          line.startsWith("http") &&
          line.includes("/proxy?url=")
        ) {
          try {
            const parsed = new URL(line);
            const original = parsed.searchParams.get("url");

            if (original) {
              line = original;
            }
          } catch (error) {
            console.log("Proxy decode error:", error.message);
          }
        }

        combined.push(line);

        if (line.startsWith("#EXTINF:")) {
          channels++;
        }
      }

      totalChannels += channels;

      results.push({
        name: playlist.name,
        status: "success",
        channels
      });

      console.log(playlist.name, channels);

    } catch (error) {
      console.log("FAILED:", playlist.name, error.message);

      results.push({
        name: playlist.name,
        status: "failed",
        error: error.message
      });
    }
  }

  const successful = results.filter(
    item => item.status === "success"
  ).length;

  if (successful === 0) {
    throw new Error("All playlist sources failed. Old playlist preserved.");
  }

  const output = combined.join("\n") + "\n";

  await env.PLAYLIST_KV.put(PLAYLIST_KEY, output);

  const status = {
    status: "updated",
    time: new Date().toISOString(),
    totalChannels,
    successfulSources: successful,
    failedSources: results.length - successful,
    sources: results
  };

  await env.PLAYLIST_KV.put(
    STATUS_KEY,
    JSON.stringify(status)
  );

  console.log("MERGE COMPLETED");
  console.log("Total channels:", totalChannels);

  return status;
}

export default {
  async scheduled(controller, env, ctx) {
    await updatePlaylist(env);
  },

  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname === "/") {
      return Response.json({
        worker: "sagar-m3u-updater",
        status: "running",
        update: "Every 30 minutes",
        playlist: "/playlist.m3u",
        manualUpdate: "/update",
        statusEndpoint: "/status"
      });
    }

    if (url.pathname === "/update") {
      if (request.method !== "GET" && request.method !== "POST") {
        return new Response("Method not allowed", {
          status: 405
        });
      }

      try {
        const result = await updatePlaylist(env);
        return Response.json(result);
      } catch (error) {
        return Response.json({
          status: "failed",
          error: error.message
        }, { status: 500 });
      }
    }

    if (url.pathname === "/playlist.m3u") {
      const playlist = await env.PLAYLIST_KV.get(PLAYLIST_KEY);

      if (!playlist) {
        return new Response("Playlist not generated yet", {
          status: 404
        });
      }

      return new Response(playlist, {
        headers: {
          "Content-Type": "audio/x-mpegurl; charset=utf-8",
          "Content-Disposition": 'inline; filename="Combined.m3u"',
          "Cache-Control": "no-store"
        }
      });
    }

    if (url.pathname === "/status") {
      const status = await env.PLAYLIST_KV.get(STATUS_KEY);

      return new Response(
        status || JSON.stringify({ status: "not updated yet" }),
        {
          headers: {
            "Content-Type": "application/json"
          }
        }
      );
    }

    return new Response("Not Found", { status: 404 });
  }
};
